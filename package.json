{
   "scripts": {
      "dev": "nodemon",
      "build": "tsc",
      "start": "node dist/app.js",
      "knex": "tsx node_modules/knex/bin/cli.js",
      "migrate:make": "npm run knex migrate:make",
      "migrate:latest": "npm run knex migrate:latest",
      "migrate:rollback": "npm run knex migrate:rollback",
      "docker:dev": "docker-compose up",
      "docker:dev:build": "docker-compose build",
      "docker:dev:down": "docker-compose down",
      "docker:dev:logs": "docker-compose logs -f app",
      "docker:dev:bash": "docker-compose exec app sh",
      "docker:prod": "docker-compose -f docker-compose.prod.yml up -d",
      "docker:prod:build": "docker-compose -f docker-compose.prod.yml build",
      "docker:prod:down": "docker-compose -f docker-compose.prod.yml down",
      "docker:prod:logs": "docker-compose -f docker-compose.prod.yml logs -f app",
      "docker:migrate": "docker-compose exec app npm run migrate:latest",
      "docker:migrate:prod": "docker-compose -f docker-compose.prod.yml exec app npm run migrate:latest"
   },
   "imports": {
      "#*": [
         "./dist/*",
         "./src/*"
      ]
   },
   "dependencies": {
      "cron": "^4.3.3",
      "dotenv": "^16.3.1",
      "express": "^4.18.2",
      "knex": "^2.5.1",
      "pg": "^8.11.3",
      "zod": "^4.1.11"
   },
   "devDependencies": {
      "@types/express": "^4.17.21",
      "@types/node": "^20.8.0",
      "@types/pg": "^8.10.7",
      "nodemon": "^3.0.1",
      "tsx": "^4.0.0",
      "typescript": "^5.2.2"
   }
}
